# Triage — variable NAMES only. Copy to .env (gitignored) and fill in locally. Nothing here is read before Phase 2.
# The live provider refuses unless TRIAGE_LIVE=1 AND ANTHROPIC_API_KEY is set; tests and CI never set either.
ANTHROPIC_API_KEY=
TRIAGE_LIVE=
# Hard caps in cents (D-19, O-2). Defaults apply when unset: 400 per run (D-48), 1500 per project over the ledger.
TRIAGE_RUN_CAP_CENTS=
TRIAGE_PROJECT_CAP_CENTS=
# HTTP handler (task 3.4, D-56): triage:serve refuses to start without this bearer token; N9 sends it as `Authorization: Bearer <token>`. Never logged.
TRIAGE_HTTP_TOKEN=
